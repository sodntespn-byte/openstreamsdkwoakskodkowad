# ====================================
# SUPERFLIX - Variaveis de Ambiente
# ====================================
# Copie este arquivo para .env.local e preencha os valores
# cp .env.example .env.local

# -------------------------------------
# TMDB API (OBRIGATORIO)
# -------------------------------------
# Crie uma conta em: https://www.themoviedb.org/signup
# Pegue sua chave em: https://www.themoviedb.org/settings/api
NEXT_PUBLIC_TMDB_API_KEY="sua_chave_tmdb_aqui"

# -------------------------------------
# POSTGRESQL (OBRIGATORIO para producao)
# -------------------------------------
# String de conexao do PostgreSQL
# Formato: postgres://usuario:senha@host:porta/banco?sslmode=disable
# Sem essa variavel, o sistema usa memoria (dados perdem ao reiniciar)
POSTGRES_URL="postgres://usuario:senha@localhost:5432/superflix"

# -------------------------------------
# JWT / AUTENTICACAO (OBRIGATORIO em producao)
# -------------------------------------
# Chave secreta para assinar tokens JWT
# Gere uma chave segura: openssl rand -base64 32
JWT_SECRET="seu_jwt_secret_aqui"

# Duração do JWT (ex.: 3d, 12h). Alinhado ao cookie de sessão.
# JWT_EXPIRES_IN="3d"

# Custo bcrypt (10–14). Mais alto = mais seguro e mais CPU.
# BCRYPT_ROUNDS="12"

# -------------------------------------
# SuperFlixAPI — player, calendário, listas (opcional)
# -------------------------------------
# Domínio principal (calendário: /calendario.php, player: /filme/, /serie/)
# NEXT_PUBLIC_SUPERFLIX_API_URL="https://superflixapi.best"

# -------------------------------------
# RAPIDAPI — IMDb236 (opcional)
# -------------------------------------
# Para notas IMDb e dados extra na página do filme / pessoa:
# https://rapidapi.com/ — subscrição "imdb236", host imdb236.p.rapidapi.com
# NUNCA commite a chave real; use apenas .env.local
# RAPIDAPI_KEY="sua_chave_rapidapi"

# URL base da aplicacao (para links e callbacks)
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# URL pública (produção) — usada na validação de origem do proxy de embed
# NEXT_PUBLIC_APP_URL="https://seu-dominio.com"

# Debug do proxy de embed (não usar em produção)
# DEBUG_PROXY="1"

# -------------------------------------
# SETUP inicial (GET /api/setup?secret=...)
# -------------------------------------
# SETUP_SECRET="valor_longo_secreto"
# SETUP_ADMIN_EMAIL="admin@exemplo.com"
# SETUP_ADMIN_PASSWORD="senha_forte"
# SETUP_ADMIN_NAME="Administrador"

# Desabilitar proxy (se tiver problemas de conexao)
# NEXT_PUBLIC_USE_PROXY="false"

# -------------------------------------
# URL inicial do browser na sala VM (opcional)
# Página inicial do PC virtual (não é a API de filmes)
# NEXT_PUBLIC_SALA_START_URL="https://www.google.com"

# HYPERBEAM — Sala VM partilhada (opcional)
# -------------------------------------
# Ativar: NEXT_PUBLIC_ENABLE_HYPERBEAM=true
# Chave secreta APENAS no servidor (Dashboard Hyperbeam → API keys)
# NUNCA commite sk_test_ / sk_live_ no repositório
# NEXT_PUBLIC_ENABLE_HYPERBEAM="false"
# HYPERBEAM_API_KEY="sk_test_..."
